# data folder should be downloaded from google drive
data/

# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Type checking
.mypy_cache/
.pytype/
.pyre/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Environment variables
.env
.env.*
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs: stray logs are ignored; archived run logs under logs/ are the
# evidence behind reported figures and ARE committed (see logs/README.md)
*.log
!logs/**/*.log

# Model artifacts: weights stay local; runs/*/history.* are committed
*.pt
*.pth
*.ckpt
*.pkl
*.pickle

# Per-month tensor bundles (rebuilt by run_real_training.py)
cache/

# Cluster job logs
cluster/logs/
.venv-cluster/

# Live forward test: large or regenerable local state (scores and runs.jsonl ARE committed)
runs/live/payloads/
runs/live/smoke_cache/
runs/live/state/

# Maker caches regenerated by the scripts
runs/maker/stgat_features_13mo.parquet
runs/maker/stgat_signal_test.parquet
runs/maker/policy_*_scores_*.parquet
runs/maker/learned_policy_features_dev.npz
runs/maker/.a10_done
runs/tune_gbm/features.npz

# LaTeX build files of documents under docs/
docs/**/*.aux
docs/**/*.out
docs/**/*.log
docs/**/*.toc
docs/**/*.synctex.gz
docs/**/*.fdb_latexmk
docs/**/*.fls
