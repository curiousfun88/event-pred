# data folder should be downloaded from google drive
data/

# Virtual environments
venv/
.venv/
env/
.env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Type checking
.mypy_cache/
.pytype/
.pyre/

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Jupyter
*.ipynb
.ipynb_checkpoints/

# Environment variables
.env
.env.*
*.env

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs: stray logs are ignored; archived run logs under logs/ are the
# evidence behind reported figures and ARE committed (see logs/README.md)
*.log
!logs/**/*.log

# Model artifacts: weights stay local; runs/*/history.* are committed
*.pt
*.pth
*.ckpt
*.pkl
*.pickle

# Per-month tensor bundles (rebuilt by run_real_training.py)
cache/
