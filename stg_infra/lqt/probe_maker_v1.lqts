# PLUMBING PROBE (not a forward-test arm): the one-level maker template reading probe_bid / probe_ask,
# published by stg_infra/examples/lumid_signal_probe.py. Only difference from the arms: min_spread 1c
# (joins the touch at a 1c spread, common on the fast crypto series), so the rule can fire at all.
# Tests that a custom signal makes a deployed strategy act; its P&L means nothing.
strategy probe_maker_v1 {
  params { threshold: 0.01, min_spread: 0.01, improve_spread: 0.03, tick: 0.01, size_lots: 10, pos_cap: 50 }

  when signal("probe_bid") > params.threshold && market.bid > 0 && market.spread >= params.improve_spread
       && position.net_lots < params.pos_cap && ctx("instrument_tradable") > 0 {
    buy min(params.size_lots, params.pos_cap - position.net_lots) lots @ market.bid + params.tick
  } else if signal("probe_bid") > params.threshold && market.bid > 0 && market.spread >= params.min_spread
       && position.net_lots < params.pos_cap && ctx("instrument_tradable") > 0 {
    buy min(params.size_lots, params.pos_cap - position.net_lots) lots @ market.bid
  }

  when signal("probe_ask") > params.threshold && market.ask < 1.0 && market.spread >= params.improve_spread
       && position.net_lots > 0 - params.pos_cap && ctx("instrument_tradable") > 0 {
    sell min(params.size_lots, params.pos_cap + position.net_lots) lots @ market.ask - params.tick
  } else if signal("probe_ask") > params.threshold && market.ask < 1.0 && market.spread >= params.min_spread
       && position.net_lots > 0 - params.pos_cap && ctx("instrument_tradable") > 0 {
    sell min(params.size_lots, params.pos_cap + position.net_lots) lots @ market.ask
  }
}
